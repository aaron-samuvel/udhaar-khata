+        const edited =
+          values.customer.trim() !== confirm.parsedCustomer ||
+          Math.round(amount * 100) !== Math.round(confirm.parsedAmount * 100);
+        body = edited
+          ? {
+              mode: "manual",
+              customer: values.customer.trim(),
+              amountRupees: amount,
+              txnType: values.txnType,
+              phone: phone || undefined,
