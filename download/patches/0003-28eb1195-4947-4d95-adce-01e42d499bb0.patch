+          return;
+        }
+        if (!result.ok || !result.data.transaction || !result.data.customer) {
+          setStatus({ msg: errOf(result, "Could not save the entry."), kind: "error" });
+          return;
+        }
+
+        const txn = result.data.transaction;
+        const cust = result.data.customer;
