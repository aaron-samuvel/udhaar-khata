+   297→   297→    }
+   298→   298→    const w = window as unknown as {
+   299→   299→      SpeechRecognition?: SpeechRecognitionCtor;
+   300→   300→      webkitSpeechRecognition?: SpeechRecognitionCtor;
+   301→   301→    };
+   302→   302→    const Ctor = w.SpeechRecognition || w.webkitSpeechRecognition;
+   303→   303→    if (Ctor) {
+   304→   304→      const rec = new Ctor();
+   305→   305→      rec.lang = "en-IN";
+   306→   306→      rec.interimResults = false;
+   307→   307→      rec.maxAlternatives = 1;
+   308→   308→      rec.onresult = (event) => {
+   309→   309→        setSentence(event.results[0][0].transcript);
+   310→   310→        setStatus({ msg: "Captured speech. Check the line and press Add.", kind: "ok" });
+   311→   311→      };
+   312→   312→      rec.onerror = () => {
+   313→   313→        setStatus({ msg: "Could not capture speech. You can type the line instead.", kind: "error" });
+   314→   314→        setListening(false);
+   315→   315→      };
+   316→   316→      rec.onend = () => setListening(false);
+   317→   317→      recognitionRef.current = rec;
+   318→   318→      try {
+   319→   319→        rec.start();
+   320→   320→        setListening(true);
+   321→   321→        setStatus({ msg: "Listening…", kind: "" });
+   322→   322→      } catch {
+   323→   323→        setListening(false);
+   324→   324→      }
+   325→   325→      return;
+   326→   326→    }
+   327→   327→
+   328→   328→    // Fallback: record with MediaRecorder and transcribe via the backend.
+   329→   329→    try {
+   330→   330→      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
