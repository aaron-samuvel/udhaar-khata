+   341→   341→        setListening(false);
+   342→   342→        try {
+   343→   343→          await transcribeBlob(new Blob(chunksRef.current, { type: mime }));
+   344→   344→        } catch (err) {
+   345→   345→          setStatus({ msg: (err as Error).message, kind: "error" });
+   346→   346→        }
+   347→   347→      };
+   348→   348→      mediaRecorderRef.current = recorder;
+   349→   349→      recorder.start();
+   350→   350→      setListening(true);
+   351→   351→      setStatus({ msg: "Recording… click the mic again to finish.", kind: "" });
