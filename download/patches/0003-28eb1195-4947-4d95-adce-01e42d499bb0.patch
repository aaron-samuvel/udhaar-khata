+  runId: string;
+  createdAt: string;
+}
+
+export interface SettingsPublic {
+  shopName: string;
+  overdueDays: number;
+  reminderTemplate: string;
+  demoData: boolean;
+}
+
+export interface AuditPublic {
+  id: string;
+  action: string;
+  entity: string;
+  entityId: string | null;
+  data: string;
+  createdAt: string;
+}
+
+export interface ReportsResponse {
+  range: { from: string; to: string; label: string };
+  totals: {
+    credit: number;
+    payments: number;
+    net: number;
+    creditPaise: number;
+    paymentsPaise: number;
+    count: number;
+  };
+  series: { date: string; credit: number; payments: number }[];
+  customerOutstanding: {
+    name: string;
+    phone: string | null;
+    balance: number;
+    balancePaise: number;
+    daysDue: number;
+    notes: string | null;
+  }[];
+  recent: TxnPublic[];
+  meta: { customers: number; withDues: number; settled: number };
+}
