+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { Textarea } from "@/components/ui/textarea";
+import {
+  AlertDialog,
+  AlertDialogAction,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from "@/components/ui/alert-dialog";
+import { useToast } from "@/hooks/use-toast";
+import { Loader2, MessageCircle, Undo2 } from "lucide-react";
+import { formatINR } from "@/lib/format";
+import type { CustomerPublic, TxnPublic } from "@/lib/types";
+import { errOf, khataFetch, khataPost } from "./api";
+import { EmptyState, SkeletonRows, TxnLine } from "./txn-line";
+
+export function CustomerSheet({
+  nameKey,
+  open,
+  onOpenChange,
+  onMutated,
+}: {
+  /** The selected customer's nameKey; null closes and clears. */
+  nameKey: string | null;
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  /** Called after any mutation so the parent list + dashboard refresh. */
+  onMutated: () => void;
+}) {
+  const { toast } = useToast();
+  const [customer, setCustomer] = useState<CustomerPublic | null>(null);
+  const [transactions, setTransactions] = useState<TxnPublic[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState("");
+  const [phone, setPhone] = useState("");
+  const [notes, setNotes] = useState("");
+  const [savingProfile, setSavingProfile] = useState(false);
+  const [sendingReminder, setSendingReminder] = useState(false);
+  const [reversing, setReversing] = useState<TxnPublic | null>(null);
+  const [reversingBusy, setReversingBusy] = useState(false);
+
+  const loadDetail = useCallback(async () => {
+    if (!nameKey) return;
+    setLoading(true);
+    setError("");
+    try {
+      const result = await khataFetch<{
+        ok: boolean;
+        error?: string;
+        customer?: CustomerPublic;
+        transactions?: TxnPublic[];
+      }>(`/api/customers/${encodeURIComponent(nameKey)}/transactions`);
+      if (!result.ok || !result.data.customer) {
+        setError(errOf(result, "Could not load this customer's khata."));
+        return;
+      }
+      setCustomer(result.data.customer);
+      setTransactions(result.data.transactions ?? []);
+      setPhone(result.data.customer.phone ?? "");
+      setNotes(result.data.customer.notes ?? "");
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setLoading(false);
+    }
+  }, [nameKey]);
+
+  useEffect(() => {
+    if (open && nameKey) {
+      void loadDetail();
+    }
+    if (!open) {
+      setCustomer(null);
+      setTransactions([]);
+      setError("");
+    }
+  }, [open, nameKey, loadDetail]);
+
+  const saveProfile = useCallback(async () => {
+    if (!nameKey) return;
+    setSavingProfile(true);
+    try {
+      const result = await khataFetch<{
+        ok: boolean;
+        error?: string;
+        customer?: CustomerPublic;
+      }>(`/api/customers/${encodeURIComponent(nameKey)}`, {
+        method: "PATCH",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ phone: phone.trim(), notes: notes.trim() }),
+      });
+      if (!result.ok || !result.data.customer) {
+        toast({ title: "Could not save profile", description: errOf(result), variant: "destructive" });
+        return;
+      }
+      setCustomer(result.data.customer);
+      toast({ title: "Profile saved", description: `${result.data.customer.name}'s details updated.` });
+      onMutated();
+    } catch (e) {
+      toast({ title: "Could not save profile", description: (e as Error).message, variant: "destructive" });
+    } finally {
+      setSavingProfile(false);
+    }
+  }, [nameKey, phone, notes, toast, onMutated]);
+
+  const sendReminder = useCallback(async () => {
+    if (!customer) return;
+    setSendingReminder(true);
+    try {
+      const result = await khataPost<{ ok: boolean; reminder?: { whatsappUrl: string } }>(
+        "/api/reminders/customer",
+        { name: customer.name }
+      );
+      if (result.status === 201 && result.data.reminder) {
+        toast({
+          title: "Reminder ready",
+          description: "WhatsApp opened with the reminder message.",
+        });
+        window.open(result.data.reminder.whatsappUrl, "_blank", "noopener,noreferrer");
+        onMutated();
+      } else {
+        toast({
+          title: "No reminder sent",
+          description: errOf(result, "This customer has no outstanding balance."),
+          variant: "destructive",
+        });
+      }
+    } catch (e) {
+      toast({ title: "No reminder sent", description: (e as Error).message, variant: "destructive" });
+    } finally {
+      setSendingReminder(false);
+    }
+  }, [customer, toast, onMutated]);
+
+  const confirmReverse = useCallback(async () => {
+    if (!reversing) return;
+    setReversingBusy(true);
+    try {
+      const result = await khataPost(`/api/transactions/${reversing.id}/reverse`, {});
+      if (!result.ok) {
+        toast({ title: "Could not reverse entry", description: errOf(result), variant: "destructive" });
+        return;
+      }
+      toast({ title: "Entry reversed", description: "A correction line was added to the ledger." });
+      setReversing(null);
+      await loadDetail();
+      onMutated();
+    } catch (e) {
+      toast({ title: "Could not reverse entry", description: (e as Error).message, variant: "destructive" });
+    } finally {
+      setReversingBusy(false);
+    }
+  }, [reversing, toast, loadDetail, onMutated]);
+
+  const isDue = (customer?.balancePaise ?? 0) > 0;
+
+  return (
+    <>
+      <Sheet open={open} onOpenChange={onOpenChange}>
+        <SheetContent
+          side="right"
+          className="khata-card sm:max-w-md overflow-y-auto khata-scroll"
+        >
+          <SheetHeader>
+            <SheetTitle className="font-serif-khata text-xl text-[#1c261f]">
+              {customer?.name ?? "Customer"}
+            </SheetTitle>
+            <SheetDescription className="sr-only">
+              Customer khata details, profile editing and ledger history.
+            </SheetDescription>
+            {customer && (
+              <div className="flex flex-wrap items-center gap-2 pt-1">
+                <span
+                  className={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-bold ${
+                    isDue
+                      ? "bg-[#f6d9d9] text-[#9b2c2c]"
+                      : "bg-[#d8e8e1] text-[#0f5c4c]"
+                  }`}
+                >
+                  {isDue
+                    ? `Due ${formatINR(customer.balancePaise)}`
+                    : `Settled ${formatINR(customer.balancePaise)}`}
+                </span>
+                {customer.phone && (
+                  <span className="text-sm text-[#5c6b62]">{customer.phone}</span>
+                )}
+              </div>
+            )}
+          </SheetHeader>
+
+          {loading ? (
+            <div className="px-4 pb-6">
+              <SkeletonRows rows={5} />
+            </div>
+          ) : error ? (
+            <p className="px-4 pb-6 text-sm font-medium text-[#9b2c2c]" role="alert">
+              {error}
+            </p>
+          ) : !customer ? null : (
+            <div className="space-y-6 px-4 pb-8">
+              {/* profile */}
+              <section aria-label="Customer profile">
+                <h3 className="text-xs font-semibold uppercase tracking-wide text-[#5c6b62] mb-2">
+                  Profile
+                </h3>
+                <div className="space-y-3">
+                  <div className="grid gap-1.5">
+                    <Label htmlFor="cust-phone" className="text-sm">
+                      Phone
+                    </Label>
+                    <Input
+                      id="cust-phone"
+                      type="tel"
+                      inputMode="numeric"
+                      value={phone}
+                      placeholder="9876543210"
+                      onChange={(e) => setPhone(e.target.value)}
+                      className="bg-white border-[#e2d5c0]"
+                    />
+                  </div>
+                  <div className="grid gap-1.5">
+                    <Label htmlFor="cust-notes" className="text-sm">
+                      Notes
+                    </Label>
+                    <Textarea
+                      id="cust-notes"
+                      value={notes}
+                      placeholder="Private note about this customer…"
+                      onChange={(e) => setNotes(e.target.value)}
+                      className="bg-white border-[#e2d5c0] min-h-20"
+                    />
+                  </div>
+                  <Button
+                    type="button"
+                    onClick={saveProfile}
+                    disabled={savingProfile}
+                    className="bg-[#0f5c4c] text-white hover:bg-[#0a3f35]"
+                  >
+                    {savingProfile && (
+                      <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+                    )}
+                    Save profile
+                  </Button>
+                </div>
+              </section>
+
+              {/* quick actions */}
+              <section aria-label="Quick actions">
+                <h3 className="text-xs font-semibold uppercase tracking-wide text-[#5c6b62] mb-2">
+                  Quick actions
+                </h3>
+                <Button
+                  type="button"
+                  disabled={sendingReminder}
+                  onClick={sendReminder}
+                  className="bg-[#128c7e] text-white hover:bg-[#0e7263]"
+                  aria-label={`Send WhatsApp reminder to ${customer.name}`}
+                >
+                  {sendingReminder ? (
+                    <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+                  ) : (
+                    <MessageCircle className="size-4" aria-hidden="true" />
+                  )}
+                  WhatsApp reminder
+                </Button>
+              </section>
+
+              {/* ledger history */}
+              <section aria-label="Ledger history">
+                <h3 className="text-xs font-semibold uppercase tracking-wide text-[#5c6b62] mb-2">
+                  Ledger history
+                </h3>
+                {transactions.length === 0 ? (
+                  <EmptyState text="No entries yet for this customer." />
+                ) : (
+                  <ul className="max-h-96 overflow-y-auto khata-scroll pr-1">
+                    {transactions.map((txn) => (
+                      <TxnLine
+                        key={txn.id}
+                        txn={txn}
+                        showName={false}
+                        onReverse={(t) => setReversing(t)}
+                      />
+                    ))}
+                  </ul>
+                )}
+              </section>
+            </div>
+          )}
+        </SheetContent>
+      </Sheet>
+
+      {/* reverse confirmation */}
+      <AlertDialog
+        open={reversing !== null}
+        onOpenChange={(open) => {
+          if (!open) setReversing(null);
+        }}
+      >
+        <AlertDialogContent className="khata-card max-w-md">
+          <AlertDialogHeader>
+            <AlertDialogTitle className="font-serif-khata text-[#1c261f]">
+              Reverse this entry?
+            </AlertDialogTitle>
+            <AlertDialogDescription className="text-[#5c6b62]">
+              A correction line will be added and the balance adjusted. This does not
+              delete history.
+            </AlertDialogDescription>
+          </AlertDialogHeader>
+          <AlertDialogFooter>
+            <AlertDialogCancel className="border-[#e2d5c0] text-[#5c6b62]">
+              Cancel
+            </AlertDialogCancel>
+            <AlertDialogAction
+              className="bg-[#9b2c2c] text-white hover:bg-[#7a231f]"
+              onClick={confirmReverse}
+              disabled={reversingBusy}
+            >
+              {reversingBusy && (
+                <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+              )}
+              <Undo2 className="size-4" aria-hidden="true" />
+              Reverse entry
+            </AlertDialogAction>
+          </AlertDialogFooter>
+        </AlertDialogContent>
+      </AlertDialog>
+    </>
+  );
+}
diff --git a/src/components/khata/entry-form.tsx b/src/components/khata/entry-form.tsx
new file mode 100644
index 0000000..1333ac3
--- /dev/null
+++ b/src/components/khata/entry-form.tsx
@@ -0,0 +1,164 @@
+"use client";
+
+/**
+ * The editable entry form shared by parse-confirm and manual entry modes.
+ * Used only AFTER the user has explicitly triggered an entry — the parser
+ * never saves anything without this form's confirm step.
+ */
+
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { formatINR, rupeesToPaise } from "@/lib/format";
+import type { TxnType } from "@/lib/types";
+import { cn } from "@/lib/utils";
+
+export interface EntryValues {
+  customer: string;
+  /** Kept as the raw input string so the field behaves naturally while typing. */
+  amountRupees: string;
+  txnType: TxnType;
+  phone: string;
+  note: string;
+}
+
+export const emptyEntry: EntryValues = {
+  customer: "",
+  amountRupees: "",
+  txnType: "UDHAAR",
+  phone: "",
+  note: "",
+};
+
+export function EntryForm({
+  values,
+  onChange,
+  showNote,
+  disabled,
+}: {
+  values: EntryValues;
+  onChange: (patch: Partial<EntryValues>) => void;
+  showNote: boolean;
+  disabled?: boolean;
+}) {
+  const parsedAmount = Number.parseFloat(values.amountRupees);
+  const showAmountPreview =
+    values.txnType === "UDHAAR"
+      ? "recorded as udhaar (credit given)"
+      : "recorded as payment (cash received)";
+
+  return (
+    <div className="grid gap-3 sm:grid-cols-2">
+      <div className="grid gap-1.5">
+        <Label htmlFor="entry-customer" className="text-sm text-[#1c261f]">
+          Customer name
+        </Label>
+        <Input
+          id="entry-customer"
+          value={values.customer}
+          disabled={disabled}
+          placeholder="e.g. Ramesh"
+          onChange={(e) => onChange({ customer: e.target.value })}
+          className="bg-white border-[#e2d5c0]"
+        />
+      </div>
+
+      <div className="grid gap-1.5">
+        <Label htmlFor="entry-amount" className="text-sm text-[#1c261f]">
+          Amount ₹
+        </Label>
+        <Input
+          id="entry-amount"
+          type="number"
+          step="0.01"
+          min="0"
+          inputMode="decimal"
+          value={values.amountRupees}
+          disabled={disabled}
+          placeholder="0.00"
+          onChange={(e) => onChange({ amountRupees: e.target.value })}
+          className="bg-white border-[#e2d5c0]"
+        />
+        {Number.isFinite(parsedAmount) && parsedAmount > 0 && (
+          <p
+            className={cn(
+              "text-xs font-semibold",
+              values.txnType === "UDHAAR" ? "text-[#9b2c2c]" : "text-[#0f5c4c]"
+            )}
+            aria-live="polite"
+          >
+            {values.txnType === "UDHAAR" ? "+" : "−"}
+            {formatINR(rupeesToPaise(parsedAmount))} · {showAmountPreview}
+          </p>
+        )}
+      </div>
+
+      <div className="grid gap-1.5">
+        <Label className="text-sm text-[#1c261f]">Type</Label>
+        <div className="grid grid-cols-2 gap-2" role="group" aria-label="Entry type">
+          <button
+            type="button"
+            aria-pressed={values.txnType === "UDHAAR"}
+            disabled={disabled}
+            onClick={() => onChange({ txnType: "UDHAAR" })}
+            className={cn(
+              "rounded-lg border px-3 py-2 text-sm font-semibold transition-colors",
+              values.txnType === "UDHAAR"
+                ? "bg-[#9b2c2c] text-white border-[#9b2c2c]"
+                : "bg-white text-[#5c6b62] border-[#e2d5c0] hover:border-[#9b2c2c]/50"
+            )}
+          >
+            Udhaar (due)
+          </button>
+          <button
+            type="button"
+            aria-pressed={values.txnType === "PAYMENT"}
+            disabled={disabled}
+            onClick={() => onChange({ txnType: "PAYMENT" })}
+            className={cn(
+              "rounded-lg border px-3 py-2 text-sm font-semibold transition-colors",
+              values.txnType === "PAYMENT"
+                ? "bg-[#0f5c4c] text-white border-[#0f5c4c]"
+                : "bg-white text-[#5c6b62] border-[#e2d5c0] hover:border-[#0f5c4c]/50"
+            )}
+          >
+            Payment (received)
+          </button>
+        </div>
+      </div>
+
+      <div className="grid gap-1.5">
+        <Label htmlFor="entry-phone" className="text-sm text-[#1c261f]">
+          Phone <span className="font-normal text-[#5c6b62]">(optional)</span>
+        </Label>
+        <Input
+          id="entry-phone"
+          type="tel"
+          inputMode="numeric"
+          value={values.phone}
+          disabled={disabled}
+          placeholder="9876543210"
+          onChange={(e) => onChange({ phone: e.target.value })}
+          className="bg-white border-[#e2d5c0]"
+        />
+        <p className="text-xs text-[#5c6b62]">10 digits, for WhatsApp reminders</p>
+      </div>
+
+      {showNote && (
+        <div className="grid gap-1.5 sm:col-span-2">
+          <Label htmlFor="entry-note" className="text-sm text-[#1c261f]">
+            Note <span className="font-normal text-[#5c6b62]">(optional)</span>
+          </Label>
+          <Input
+            id="entry-note"
+            value={values.note}
+            disabled={disabled}
+            maxLength={200}
+            placeholder="e.g. 2 kg rice, paying Friday"
+            onChange={(e) => onChange({ note: e.target.value })}
+            className="bg-white border-[#e2d5c0]"
+          />
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/khata/tabs/customers-tab.tsx b/src/components/khata/tabs/customers-tab.tsx
new file mode 100644
index 0000000..807735b
--- /dev/null
+++ b/src/components/khata/tabs/customers-tab.tsx
@@ -0,0 +1,203 @@
+"use client";
+
+/**
+ * TAB 2 — Customers: search + filter chips, customer rows and the detail sheet.
+ */
+
+import { useCallback, useEffect, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Loader2, Search } from "lucide-react";
+import { formatINR } from "@/lib/format";
+import type { CustomerPublic } from "@/lib/types";
+import { daysSince, errOf, khataFetch, relTime } from "../api";
+import { EmptyState, SkeletonRows } from "../txn-line";
+import { CustomerSheet } from "../customer-sheet";
+
+type CustomerFilter = "all" | "due" | "settled";
+
+export function CustomersTab({ refreshAll }: { refreshAll: () => Promise<void> }) {
+  const [query, setQuery] = useState("");
+  const [debounced, setDebounced] = useState("");
+  const [filter, setFilter] = useState<CustomerFilter>("all");
+  const [list, setList] = useState<CustomerPublic[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+  const [selected, setSelected] = useState<CustomerPublic | null>(null);
+  const [sheetOpen, setSheetOpen] = useState(false);
+  const [refreshing, setRefreshing] = useState(false);
+
+  // Debounce the search query (250 ms) before hitting the API.
+  useEffect(() => {
+    const t = setTimeout(() => setDebounced(query.trim()), 250);
+    return () => clearTimeout(t);
+  }, [query]);
+
+  const load = useCallback(async () => {
+    setLoading(true);
+    setError("");
+    try {
+      const url = debounced
+        ? `/api/customers?q=${encodeURIComponent(debounced)}`
+        : "/api/customers";
+      const result = await khataFetch<{
+        ok: boolean;
+        error?: string;
+        customers?: CustomerPublic[];
+      }>(url);
+      if (!result.ok) {
+        setError(errOf(result, "Could not load customers."));
+        return;
+      }
+      setList(result.data.customers ?? []);
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setLoading(false);
+    }
+  }, [debounced]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const refreshFromSheet = useCallback(() => {
+    void load();
+    void refreshAll();
+  }, [load, refreshAll]);
+
+  const visible = list.filter((c) => {
+    if (filter === "due") return c.balancePaise > 0;
+    if (filter === "settled") return c.balancePaise <= 0;
+    return true;
+  });
+
+  const filterChip = (value: CustomerFilter, label: string) => (
+    <button
+      type="button"
+      aria-pressed={filter === value}
+      onClick={() => setFilter(value)}
+      className={`rounded-full px-3 py-1 text-xs font-semibold transition-colors ${
+        filter === value
+          ? "bg-[#0f5c4c] text-white"
+          : "bg-[#efe4d2] text-[#5c6b62] hover:text-[#1c261f]"
+      }`}
+    >
+      {label}
+    </button>
+  );
+
+  return (
+    <div className="space-y-4">
+      <section aria-labelledby="customers-heading">
+        <div className="flex items-center justify-between gap-3">
+          <h2
+            id="customers-heading"
+            className="font-serif-khata text-lg font-bold text-[#1c261f]"
+          >
+            Customers
+          </h2>
+          <Button
+            variant="ghost"
+            size="sm"
+            className="text-[#5c6b62]"
+            aria-label="Refresh customer list"
+            onClick={() => {
+              setRefreshing(true);
+              void load().finally(() => setRefreshing(false));
+            }}
+          >
+            {refreshing ? (
+              <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+            ) : null}
+            Refresh
+          </Button>
+        </div>
+
+        <div className="mt-2 flex flex-col sm:flex-row sm:items-center gap-2">
+          <div className="relative flex-1">
+            <Search
+              className="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-[#5c6b62]"
+              aria-hidden="true"
+            />
+            <Input
+              value={query}
+              onChange={(e) => setQuery(e.target.value)}
+              placeholder="Search customers…"
+              aria-label="Search customers"
+              className="pl-9 bg-white border-[#e2d5c0]"
+            />
+          </div>
+          <div className="flex gap-2" role="group" aria-label="Filter customers">
+            {filterChip("all", "All")}
+            {filterChip("due", "Due")}
+            {filterChip("settled", "Settled")}
+          </div>
+        </div>
+
+        <div className="mt-3 khata-card rounded-2xl p-3 sm:p-4">
+          {error ? (
+            <p className="text-sm font-medium text-[#9b2c2c] py-3 px-1" role="alert">
+              {error}
+            </p>
+          ) : loading && list.length === 0 ? (
+            <SkeletonRows rows={5} />
+          ) : visible.length === 0 ? (
+            <EmptyState
+              text={
+                query
+                  ? "No customers match that search."
+                  : "No customers yet — record your first entry on the Khata tab."
+              }
+            />
+          ) : (
+            <ul>
+              {visible.map((c) => {
+                const due = c.balancePaise > 0;
+                const dueDays = daysSince(c.firstDueAt);
+                return (
+                  <li key={c.nameKey}>
+                    <button
+                      type="button"
+                      onClick={() => {
+                        setSelected(c);
+                        setSheetOpen(true);
+                      }}
+                      className="w-full text-left px-2 py-3 rounded-xl hover:bg-[#efe4d2]/60 focus-visible:bg-[#efe4d2]/80 transition-colors border-b border-[#e2d5c0]/70 last:border-b-0"
+                      aria-label={`Open khata for ${c.name}`}
+                    >
+                      <div className="flex items-start justify-between gap-3">
+                        <div className="min-w-0">
+                          <p className="font-bold text-[#1c261f] truncate">{c.name}</p>
+                          <p className="text-xs text-[#5c6b62] mt-0.5 truncate">
+                            {c.phone ? `${c.phone} · ` : ""}
+                            {c.lastTxnAt ? `last entry ${relTime(c.lastTxnAt)}` : "no entries yet"}
+                            {due && c.firstDueAt ? ` · due since ${dueDays} day${dueDays === 1 ? "" : "s"}` : ""}
+                          </p>
+                        </div>
+                        <span
+                          className={`shrink-0 font-bold tabular-nums ${
+                            due ? "text-[#9b2c2c]" : "text-[#0f5c4c]"
+                          }`}
+                        >
+                          {due ? formatINR(c.balancePaise) : "settled"}
+                        </span>
+                      </div>
+                    </button>
+                  </li>
+                );
+              })}
+            </ul>
+          )}
+        </div>
+      </section>
+
+      <CustomerSheet
+        nameKey={selected?.nameKey ?? null}
+        open={sheetOpen}
+        onOpenChange={setSheetOpen}
+        onMutated={refreshFromSheet}
+      />
+    </div>
+  );
+}
