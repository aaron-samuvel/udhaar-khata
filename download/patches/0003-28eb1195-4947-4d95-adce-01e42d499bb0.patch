diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index 4b55c32..682cd5d 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -7,48 +7,80 @@ datasource db {
   url      = env("DATABASE_URL")
 }
 
-// A customer of the kirana shop with a running udhaar (credit) balance.
+// A customer of the shop with a running udhaar (credit) balance.
+// NOTE: all money is stored as INTEGER PAISE (1 rupee = 100 paise) so that
+// balance arithmetic is exact — never binary floating point.
 model Customer {
-  nameKey     String    @id // normalized uppercase name, used as the stable key
-  name        String
-  balance     Float     @default(0)
-  phone       String?
-  firstDueAt  DateTime? // when the current outstanding cycle started
-  lastTxnAt   DateTime?
-  createdAt   DateTime  @default(now())
-  updatedAt   DateTime  @updatedAt
+  nameKey      String       @id // normalized uppercase name, stable key
+  name         String
+  balancePaise Int          @default(0)
+  phone        String?
+  notes        String? // shopkeeper's private note about the customer
+  firstDueAt   DateTime? // when the current outstanding cycle started
+  lastTxnAt    DateTime?
+  createdAt    DateTime     @default(now())
+  updatedAt    DateTime     @updatedAt
   transactions Transaction[]
 
-  @@index([balance])
+  @@index([balancePaise])
 }
 
-// An immutable ledger line: either UDHAAR (credit given) or PAYMENT (cash received).
+// An immutable ledger line: UDHAAR (credit given) or PAYMENT (cash received).
+// A reversal is a NEW offsetting line (isReversal=true) — originals are never
+// deleted or mutated in place, which keeps the audit history intact.
 model Transaction {
-  id        String   @id @default(cuid())
-  nameKey   String
-  name      String
-  amount    Float
-  txnType   String // "UDHAAR" | "PAYMENT"
-  rawText   String
-  createdAt DateTime @default(now())
+  id           String   @id @default(cuid())
+  nameKey      String
+  name         String
+  amountPaise  Int
+  txnType      String // "UDHAAR" | "PAYMENT"
