+   273→   273→  const transcribeBlob = useCallback(async (blob: Blob) => {
+   274→   274→    setStatus({ msg: "Transcribing your recording…", kind: "" });
+   275→   275→    const buf = await blob.arrayBuffer();
+   276→   276→    let binary = "";
+   277→   277→    const bytes = new Uint8Array(buf);
+   278→   278→    const chunk = 0x8000;
+   279→   279→    for (let i = 0; i < bytes.length; i += chunk) {
+   280→   280→      binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
+   281→   281→    }
+   282→   282→    const res = await fetch("/api/transcribe", {
+   283→   283→      method: "POST",
+   284→   284→      headers: { "content-type": "application/json" },
+   285→   285→      body: JSON.stringify({ audio_base64: btoa(binary) }),
+   286→   286→    });
+   287→   287→    const data = await res.json();
+   288→   288→    if (!res.ok) throw new Error(data.error || "Could not transcribe the audio.");
+   289→   289→    setSentence(data.text);
+   290→   290→    setStatus({ msg: "Captured speech. Check the line and press Add.", kind: "ok" });
+   291→   291→  }, []);
