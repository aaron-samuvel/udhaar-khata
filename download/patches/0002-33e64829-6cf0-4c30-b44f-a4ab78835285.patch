new file mode 100644
index 0000000..105a42c
--- /dev/null
+++ b/src/lib/khata.ts
@@ -0,0 +1,268 @@
+import { db } from "@/lib/db";
+import { parse, type ParseResult } from "@/lib/parser";
+
+/** Normalize a customer name into a stable key: trimmed, single-spaced, uppercase. */
+export function nameKey(name: string): string {
+  return (name ?? "").trim().replace(/\s+/g, " ").toUpperCase();
+}
+
+export function round2(n: number): number {
+  return Math.round(n * 100) / 100;
+}
+
+/** Keep only 10-digit Indian phone numbers (strips +91 / 91 prefixes). */
+export function normalizePhone(phone?: string | null): string | null {
+  if (!phone) return null;
+  let digits = String(phone).replace(/\D/g, "");
+  if (digits.startsWith("91") && digits.length === 12) digits = digits.slice(2);
+  if (digits.length === 10) return digits;
+  return null;
+}
+
+/** Build a wa.me deep link with a pre-filled Hinglish reminder message. */
+export function whatsappLink(
+  name: string,
+  balance: number,
+  phone?: string | null
+): { url: string; message: string } {
+  const amount = round2(balance).toFixed(2);
+  const message = `Namaste ${name} ji, aapka udhaar Rs ${amount} pending hai. Kripya jald payment kar dein. Dhanyavaad! — Udhaar Khata`;
+  const encoded = encodeURIComponent(message);
+  const digits = normalizePhone(phone);
+  const url = digits
+    ? `https://wa.me/91${digits}?text=${encoded}`
+    : `https://wa.me/?text=${encoded}`;
+  return { url, message };
+}
+
+export function daysSince(iso: Date | null | undefined): number {
+  if (!iso) return 0;
+  const delta = Date.now() - new Date(iso).getTime();
+  return Math.max(0, Math.floor(delta / 86_400_000));
+}
+
+export function money(n: number): string {
+  return "₹" + Number(n).toLocaleString("en-IN", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+}
+
+export interface PublicCustomer {
+  name: string;
+  nameKey: string;
+  balance: number;
+  phone: string | null;
+  firstDueAt: string | null;
+  lastTxnAt: string | null;
+  createdAt: string;
+}
+
+export interface PublicTransaction {
+  id: string;
+  name: string;
+  amount: number;
+  txnType: "UDHAAR" | "PAYMENT";
+  rawText: string;
+  createdAt: string;
+}
+
+export interface PublicReminder {
+  id: string;
+  name: string;
+  balance: number;
+  daysOverdue: number;
+  phone: string | null;
+  whatsappUrl: string;
+  message: string;
+  runId: string;
+  createdAt: string;
+}
+
+export async function addTransaction(
+  customer: string,
+  amount: number,
+  txnType: "UDHAAR" | "PAYMENT",
+  rawText: string,
+  phone?: string | null
+) {
+  const amountR = round2(amount);
+  if (amountR <= 0) throw new Error("Amount must be greater than zero.");
+
+  const key = nameKey(customer);
+  const now = new Date();
+  const existing = await db.customer.findUnique({ where: { nameKey: key } });
+  const oldBalance = existing?.balance ?? 0;
+  const newBalance =
+    txnType === "UDHAAR" ? round2(oldBalance + amountR) : round2(oldBalance - amountR);
+
+  let firstDueAt = existing?.firstDueAt ?? null;
+  if (newBalance > 0 && (!firstDueAt || oldBalance <= 0)) {
+    firstDueAt = now;
+  }
+  if (newBalance <= 0) {
+    firstDueAt = null;
+  }
+
+  const savedPhone = normalizePhone(phone) ?? existing?.phone ?? null;
+  const displayName = existing?.name ?? customer;
+
+  // Customer row must exist before the ledger line (FK), so upsert first.
+  const [, txn] = await db.$transaction([
+    db.customer.upsert({
+      where: { nameKey: key },
+      create: {
+        nameKey: key,
+        name: displayName,
+        balance: newBalance,
+        phone: savedPhone,
+        firstDueAt,
+        lastTxnAt: now,
+      },
+      update: {
+        name: displayName,
+        balance: newBalance,
+        phone: savedPhone,
+        firstDueAt,
+        lastTxnAt: now,
+      },
+    }),
+    db.transaction.create({
+      data: {
+        nameKey: key,
+        name: displayName,
+        amount: amountR,
+        txnType,
+        rawText,
+        createdAt: now,
+      },
+    }),
+  ]);
+
+  return {
+    transaction: txn,
+    customer: {
+      name: displayName,
+      nameKey: key,
+      balance: newBalance,
+      phone: savedPhone,
+      firstDueAt: firstDueAt ? firstDueAt.toISOString() : null,
+      lastTxnAt: now.toISOString(),
+    },
+  };
+}
+
+export async function saveParsedTransaction(
+  parsed: ParseResult,
+  phone?: string | null
+) {
+  return addTransaction(
+    parsed.customer!,
+    parsed.amount!,
+    parsed.txnType!,
+    parsed.rawText,
+    phone
+  );
+}
+
+export async function listCustomers(): Promise<PublicCustomer[]> {
+  const rows = await db.customer.findMany();
+  return rows
+    .map((c) => ({
+      name: c.name,
+      nameKey: c.nameKey,
+      balance: c.balance,
+      phone: c.phone,
+      firstDueAt: c.firstDueAt ? c.firstDueAt.toISOString() : null,
+      lastTxnAt: c.lastTxnAt ? c.lastTxnAt.toISOString() : null,
+      createdAt: c.createdAt.toISOString(),
+    }))
+    .sort((a, b) => b.balance - a.balance || a.name.localeCompare(b.name));
+}
+
+export async function listTransactions(name: string): Promise<PublicTransaction[]> {
+  const key = nameKey(name);
+  const rows = await db.transaction.findMany({
+    where: { nameKey: key },
+    orderBy: { createdAt: "desc" },
+    take: 100,
+  });
+  return rows.map((t) => ({
+    id: t.id,
+    name: t.name,
+    amount: t.amount,
+    txnType: t.txnType as "UDHAAR" | "PAYMENT",
+    rawText: t.rawText,
+    createdAt: t.createdAt.toISOString(),
+  }));
+}
+
+export async function listReminders(limit = 50): Promise<PublicReminder[]> {
+  const rows = await db.reminder.findMany({
+    orderBy: { createdAt: "desc" },
+    take: limit,
+  });
+  return rows.map((r) => ({
+    id: r.id,
+    name: r.name,
+    balance: r.balance,
+    daysOverdue: r.daysOverdue,
+    phone: r.phone,
+    whatsappUrl: r.whatsappUrl,
+    message: r.message,
+    runId: r.runId,
+    createdAt: r.createdAt.toISOString(),
+  }));
+}
+
+/**
+ * Reminder run (port of the Step Functions task): find customers whose dues
+ * are older than `overdueDays` and write reminder records with WhatsApp links.
+ */
+export async function writeReminders(
+  overdueDays: number,
+  runId?: string
+): Promise<PublicReminder[]> {
+  const days = Math.max(0, Math.floor(overdueDays));
+  const rid = runId ?? Math.random().toString(36).slice(2, 12);
+  const written: PublicReminder[] = [];
+
+  for (const customer of await listCustomers()) {
+    const balance = round2(customer.balance);
+    if (balance <= 0) continue;
+    const dueFrom = customer.firstDueAt
+      ? new Date(customer.firstDueAt)
+      : customer.lastTxnAt
+        ? new Date(customer.lastTxnAt)
+        : null;
+    const age = daysSince(dueFrom);
+    if (age < days) continue;
+
+    const { url, message } = whatsappLink(customer.name, balance, customer.phone);
+    const row = await db.reminder.create({
+      data: {
+        nameKey: customer.nameKey,
+        name: customer.name,
+        balance,
+        daysOverdue: age,
+        phone: customer.phone,
+        whatsappUrl: url,
+        message,
+        runId: rid,
+      },
+    });
+    written.push({
+      id: row.id,
+      name: row.name,
+      balance: row.balance,
+      daysOverdue: row.daysOverdue,
+      phone: row.phone,
+      whatsappUrl: row.whatsappUrl,
+      message: row.message,
+      runId: row.runId,
+      createdAt: row.createdAt.toISOString(),
+    });
+  }
+
+  return written;
+}
diff --git a/src/lib/parser.ts b/src/lib/parser.ts
new file mode 100644
index 0000000..57f219b
--- /dev/null
+++ b/src/lib/parser.ts
@@ -0,0 +1,280 @@
+/**
+ * Parse plain English / Hinglish shop sentences into a credit-ledger entry.
+ *
+ * Ported from the original Udhaar Khata Python parser (parser.py) — a small
+ * keyword + regex routine that a shopkeeper can learn in one glance:
+ *
+ *   Ramesh took 2 kg rice for 120 rupees   -> Ramesh, Rs 120, UDHAAR
+ *   Ramesh paid 50                         -> Ramesh, Rs 50,  PAYMENT
+ *   Amit ne 200 ka udhaar liya             -> Amit,   Rs 200, UDHAAR
+ *   Sita diya 50                           -> Sita,   Rs 50,  PAYMENT
+ */
+
+export type TxnType = "UDHAAR" | "PAYMENT";
+
+export interface ParseResult {
+  ok: boolean;
+  customer?: string;
+  amount?: number;
+  txnType?: TxnType;
+  rawText: string;
+  error?: string;
+}
+
+const PAYMENT_WORDS = new Set([
+  "paid",
+  "payment",
+  "pay",
+  "pays",
+  "paying",
+  "diya",
+  "diye",
+  "dia",
+  "deya",
+  "diyaa",
+  "jama",
+  "jamah",
+  "settled",
+  "settle",
+  "settlement",
+  "wapas",
+  "waapas",
+  "return",
+  "returned",
+  "repay",
+  "repaid",
+  "clear",
+  "cleared",
+  "clearing",
+  "deposit",
+  "deposited",
+]);
+
+const UDHAAR_WORDS = new Set([
+  "took",
+  "take",
+  "takes",
+  "taken",
+  "udhaar",
+  "udhar",
+  "udhari",
+  "liya",
+  "liye",
+  "lia",
+  "liyaa",
+  "lene",
+  "credit",
+  "kharid",
+  "kharida",
+  "kharidi",
+  "kharide",
+  "bought",
+  "buy",
+  "buys",
+  "purchase",
+  "purchased",
+  "loan",
+  "due",
+  "borrowed",
+  "borrow",
+]);
+
+const HONORIFICS = new Set(["ji", "sir", "madam", "madame", "bhai", "ben", "anna"]);
+
+export const QUANTITY_UNITS = new Set([
+  "kg",
+  "kilo",
+  "kilos",
+  "kilogram",
+  "kilograms",
+  "g",
+  "gm",
+  "gram",
+  "grams",
+  "ltr",
+  "liter",
+  "litre",
+  "liters",
+  "litres",
+  "ml",
+  "packet",
+  "packets",
+  "pkt",
+  "pkts",
+  "piece",
+  "pieces",
+  "pc",
+  "pcs",
+  "item",
+  "items",
+  "dozen",
+  "darjan",
+  "bag",
+  "bags",
+  "box",
+  "boxes",
+  "bottle",
+  "bottles",
+  "tin",
+  "tins",
+]);
+
+const NAME_STOP = new Set([
+  "ne",
+  "ko",
+  "se",
+  "ke",
+  "ki",
+  "ka",
+  "a",
+  "an",
+  "the",
+  "for",
+  "from",
+  "to",
+  "of",
+  "and",
+  "rs",
+  "rupee",
+  "rupees",
+  "inr",
+  "on",
+  "in",
+  "with",
+  "by",
+  "as",
+  "has",
+  "have",
+  "had",
+  "his",
+  "her",
+  "their",
+  "my",
+  "our",
+  ...PAYMENT_WORDS,
+  ...UDHAAR_WORDS,
+  ...QUANTITY_UNITS,
+]);
+
+const AMOUNT_PATTERNS: RegExp[] = [
+  /₹\s*(\d+(?:\.\d{1,2})?)/g,
+  /(?:rs\.?|rupees?|inr)\s*(\d+(?:\.\d{1,2})?)/gi,
+  /(\d+(?:\.\d{1,2})?)\s*(?:rs\.?|rupees?|inr|₹|\/-)/gi,
+  /(?:for|ka|ki|ke)\s+(\d+(?:\.\d{1,2})?)\b/gi,
+];
+
+const round2 = (n: number) => Math.round(n * 100) / 100;
+
+function detectType(tokensLower: string[]): TxnType | null {
+  const hasPayment = tokensLower.some((t) => PAYMENT_WORDS.has(t));
+  const hasUdhaar = tokensLower.some((t) => UDHAAR_WORDS.has(t));
+  // "paid his udhaar" / "udhaar settled" is a payment.
+  if (hasPayment) return "PAYMENT";
+  if (hasUdhaar) return "UDHAAR";
+  return null;
+}
+
+function extractAmount(text: string): number | null {
+  for (const pattern of AMOUNT_PATTERNS) {
+    const matches = [...text.matchAll(pattern)].map((m) => m[1]);
+    if (matches.length > 0) {
+      return round2(parseFloat(matches[matches.length - 1]));
+    }
+  }
+
+  // Fallback: numbers that are not quantities (not followed by kg, litre, ...).
+  const tokens = text.match(/[A-Za-z]+|\d+(?:\.\d{1,2})?/g) ?? [];
+  const skip = new Set<number>();
+  for (let i = 0; i < tokens.length; i++) {
+    if (/^\d+(?:\.\d{1,2})?$/.test(tokens[i])) {
+      const next = (tokens[i + 1] ?? "").toLowerCase();
+      if (QUANTITY_UNITS.has(next)) skip.add(i);
+    }
+  }
+  const amounts: number[] = [];
+  for (let i = 0; i < tokens.length; i++) {
+    if (!skip.has(i) && /^\d+(?:\.\d{1,2})?$/.test(tokens[i])) {
+      amounts.push(parseFloat(tokens[i]));
+    }
+  }
+  if (amounts.length === 0) return null;
+  return round2(amounts[amounts.length - 1]);
+}
+
+function extractCustomer(text: string): string | null {
+  const cleaned = text.replace(/[₹,]/g, " ");
+  const words = cleaned.match(/[A-Za-z][A-Za-z'.]*/g) ?? [];
+  const parts: string[] = [];
+  for (const word of words) {
+    const lowered = word.toLowerCase().replace(/\.$/, "");
+    if (HONORIFICS.has(lowered)) continue;
+    if (NAME_STOP.has(lowered)) break;
+    parts.push(word);
+  }
+  if (parts.length === 0) return null;
+  // Most personal names in this context are one to three words.
+  const name = parts.slice(0, 3).join(" ");
+  return name
+    .split(/\s+/)
+    .map((p) => p.charAt(0).toUpperCase() + p.slice(1))
+    .join(" ");
+}
+
+export function parse(input: string | null | undefined): ParseResult {
+  if (input === null || input === undefined || !String(input).trim()) {
+    return {
+      ok: false,
+      rawText: input === null || input === undefined ? "" : String(input),
+      error:
+        "Please enter a sentence, for example: 'Ramesh took 2 kg rice for 120 rupees'.",
+    };
+  }
+
+  const raw = String(input).trim();
+  const normalized = raw.replace(/\s+/g, " ").replace(/,/g, "");
+
+  const tokens = normalized.match(/[A-Za-z]+|\d+(?:\.\d+)?/g) ?? [];
+  const tokensLower = tokens.map((t) => t.toLowerCase());
+
+  const txnType = detectType(tokensLower);
+  const amount = extractAmount(normalized);
+  const customer = extractCustomer(normalized);
+
+  if (!customer) {
+    return {
+      ok: false,
+      rawText: raw,
+      error:
+        "Could not find the customer name. Try starting with the name, for example: 'Ramesh paid 50'.",
+    };
+  }
+  if (amount === null) {
+    return {
+      ok: false,
+      rawText: raw,
+      customer,
+      error:
+        "Could not find the amount. Try 'Ramesh paid 50' or 'Ramesh took rice for 120 rupees'.",
+    };
+  }
+  if (amount <= 0) {
+    return {
+      ok: false,
+      rawText: raw,
+      customer,
+      amount,
+      error: "Amount must be greater than zero.",
+    };
+  }
+  // A name plus an amount with no verb is treated as new credit, which is how
+  // a kirana owner typically uses a one-line khata entry.
+  const finalType: TxnType = txnType ?? "UDHAAR";
+
+  return {
+    ok: true,
+    customer,
+    amount,
+    txnType: finalType,
+    rawText: raw,
+  };
+}
