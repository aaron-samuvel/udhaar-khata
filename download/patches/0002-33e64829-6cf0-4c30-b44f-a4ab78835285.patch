+docker run --rm \
+    --entrypoint sh \
+    -v "$BUILD_DIR:/app" \
+    "$RUNNER_IMAGE" \
+    -c 'PYTHONPATH=/app/python-runtime/site-packages:/app/next-service-dist python /app/next-service-dist/check_runtime.py'
